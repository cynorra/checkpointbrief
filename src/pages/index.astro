---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { SITE, AUTHOR } from "../site.config.js";
import { TOPIC_BY_KEY } from "../lib/topics.js";

const guides = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const featuredGuide = guides[0];
const recentGuides = guides.slice(1);
---
<Base title={SITE.name} description={SITE.description}>
  {/* Hero / Header Section: Professional Gaming Publication */}
  <section class="relative overflow-hidden border-b bg-card/20">
    <div class="plan-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-12 pb-14 md:pt-16 md:pb-16">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-brand text-xs font-bold tracking-wider uppercase">
          <span>Editorial Gaming Journal</span>
          <span>·</span>
          <span>Verified & Sourced</span>
        </div>
        <h1 class="mt-3 text-4xl leading-[1.08] font-extrabold tracking-tight md:text-5xl lg:text-6xl">
          Fact-checked gaming analysis, release dates & guides.
        </h1>
        <p class="text-muted-foreground mt-4 text-lg md:text-xl leading-relaxed">
          {SITE.description}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
          <a href="/guides/" class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-md px-4 py-2 font-semibold no-underline transition-colors">
            Browse All Guides →
          </a>
          <a href="/about/" class="hover:bg-accent rounded-md border px-4 py-2 font-medium no-underline transition-colors">
            About Our Newsroom
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Main Magazine Layout: Featured Story + Sidebar Tools */}
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-12">
      {/* Left Column: Featured Article & Latest Stories */}
      <div class="lg:col-span-8 space-y-12">
        {featuredGuide && (
          <div>
            <div class="flex items-center justify-between border-b pb-3 mb-6">
              <span class="text-xs font-bold tracking-wider uppercase text-muted-foreground">Lead Story</span>
              <span class="text-xs text-muted-foreground">{featuredGuide.data.published.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</span>
            </div>
            <article class="group">
              <a href={`/guides/${featuredGuide.id}/`} class="no-underline block">
                <span class="text-brand text-xs font-semibold tracking-wider uppercase">{TOPIC_BY_KEY[featuredGuide.data.tool].topic}</span>
                <h2 class="font-display group-hover:text-brand mt-2 text-2xl md:text-3xl font-extrabold text-foreground transition-colors leading-tight">
                  {featuredGuide.data.title}
                </h2>
                <p class="text-muted-foreground mt-3 text-base md:text-lg leading-relaxed">
                  {featuredGuide.data.description}
                </p>
                <div class="mt-4 flex items-center gap-2 text-sm text-brand font-semibold">
                  <span>Read full analysis</span>
                  <span>→</span>
                </div>
              </a>
            </article>
          </div>
        )}

        {/* Recent Articles Stream */}
        {recentGuides.length > 0 && (
          <div class="border-t pt-8">
            <h2 class="text-xl font-extrabold tracking-tight mb-6">Recent Articles & Explanations</h2>
            <div class="divide-y border-y">
              {recentGuides.map((g) => {
                const dateStr = g.data.published.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
                return (
                  <article class="py-6 group">
                    <a href={`/guides/${g.id}/`} class="no-underline block">
                      <div class="flex items-center gap-2 text-xs text-muted-foreground mb-1.5">
                        <span class="font-semibold text-foreground uppercase tracking-wide">{TOPIC_BY_KEY[g.data.tool].topic}</span>
                        <span>·</span>
                        <time datetime={g.data.published.toISOString()} class="num">{dateStr}</time>
                      </div>
                      <h3 class="font-display group-hover:text-brand text-xl font-bold text-foreground transition-colors leading-snug">
                        {g.data.title}
                      </h3>
                      <p class="text-muted-foreground mt-2 text-sm leading-relaxed line-clamp-2">
                        {g.data.description}
                      </p>
                      <span class="text-brand text-xs font-semibold mt-3 inline-block">Read article →</span>
                    </a>
                  </article>
                );
              })}
            </div>
          </div>
        )}
      </div>

      {/* Right Column / Sidebar: Hub Trackers, Verification & Author Bio */}
      <aside class="lg:col-span-4 space-y-8" aria-label="Explore and about">
        {/* Hub Trackers Card */}
        <div class="bg-card rounded-xl border p-6">
          <h3 class="font-display text-base font-bold uppercase tracking-wider text-muted-foreground text-xs">Coverage Hubs & Tools</h3>
          <p class="text-xs text-muted-foreground mt-1">Our dedicated trackers with live updates and verified dates:</p>
          <ul class="mt-4 space-y-3 text-sm">
            <li class="border-b pb-3">
              <a href="/gta-6/" class="font-semibold text-foreground hover:text-brand flex items-center justify-between no-underline">
                <span>GTA 6 Knowledge Hub</span>
                <span class="text-muted-foreground text-xs">→</span>
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">Every verified detail, release window, and edition facts.</p>
            </li>
            <li class="border-b pb-3">
              <a href="/release-dates/" class="font-semibold text-foreground hover:text-brand flex items-center justify-between no-underline">
                <span>Release Dates Calendar</span>
                <span class="text-muted-foreground text-xs">→</span>
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">Filter upcoming games with confirmed launch dates.</p>
            </li>
            <li>
              <a href="/free-games/" class="font-semibold text-foreground hover:text-brand flex items-center justify-between no-underline">
                <span>Free Epic Games Tracker</span>
                <span class="text-muted-foreground text-xs">→</span>
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">Live updates on current and upcoming PC giveaways.</p>
            </li>
          </ul>
        </div>

        {/* Editorial Standards Box */}
        <div class="bg-card rounded-xl border p-6">
          <h3 class="font-display text-sm font-bold uppercase tracking-wider text-brand">Editorial Policy</h3>
          <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
            Every claim published on {SITE.name} is cited back to official announcements or primary filings. We do not publish unsubstantiated forum rumors as fact.
          </p>
          <div class="mt-4 flex flex-col gap-1.5 text-xs font-semibold">
            <a href="/how-we-verify/" class="text-foreground hover:text-brand">How we verify our facts →</a>
            <a href="/editorial-policy/" class="text-foreground hover:text-brand">Our editorial & advertising policy →</a>
          </div>
        </div>

        {/* Author Bio Box */}
        <div class="bg-card rounded-xl border p-6 flex gap-3.5 items-start">
          <img
            src={AUTHOR.photo}
            alt={AUTHOR.name}
            class="w-12 h-12 rounded-full object-cover border border-brand/40 shadow-2xs shrink-0"
            width="48"
            height="48"
            loading="lazy"
          />
          <div>
            <h4 class="font-bold text-sm text-foreground">Edited by <a href={`/author/${AUTHOR.slug}/`} class="text-foreground hover:text-brand">{AUTHOR.name}</a></h4>
            <p class="text-xs text-muted-foreground mt-1 leading-relaxed">
              Software engineer and gaming researcher. Tracking releases and verifying industry claims since 2026.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {/* In-depth Editorial Mission Section (Substantive Content for AdSense Quality Standards) */}
  <section aria-labelledby="editorial-mission-h" class="border-t bg-card/40">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-8 lg:grid-cols-3">
        <div>
          <p class="text-brand text-xs font-semibold tracking-wider uppercase">Publication Standards</p>
          <h2 id="editorial-mission-h" class="mt-2 text-2xl font-extrabold md:text-3xl">Why we verify every gaming claim</h2>
        </div>
        <div class="lg:col-span-2 space-y-4 text-muted-foreground leading-relaxed">
          <p>
            Major game releases and storefront giveaways create massive waves of recycled rumors, clickbait headlines, and speculative release dates. Players looking for basic answers — when a game actually launches, whether a physical edition contains a disc, or how an account bonus works — often have to dig through unsubstantiated forum claims.
          </p>
          <p>
            <strong>{SITE.name}</strong> was built to solve that noise. We treat gaming data with the discipline of documentation: every date is cross-referenced with primary publisher announcements, regulatory filings, or verified retail listings. When details remain unannounced (such as the GTA 6 PC release window), we state clearly what is unknown rather than guessing.
          </p>
          <div class="pt-2 flex flex-wrap gap-4 text-sm font-medium">
            <a href="/how-we-verify/" class="text-foreground underline decoration-border hover:decoration-brand">Read our verification process →</a>
            <a href="/editorial-policy/" class="text-foreground underline decoration-border hover:decoration-brand">Review our editorial policy →</a>
            <a href={`/author/${AUTHOR.slug}/`} class="text-foreground underline decoration-border hover:decoration-brand">Meet the author →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
