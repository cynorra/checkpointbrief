---
import Base from "../layouts/Base.astro";
import Countdown from "../components/widgets/Countdown.tsx";
import { getCollection } from "astro:content";
import { SITE, AUTHOR } from "../site.config.js";
import { TOPIC_BY_KEY } from "../lib/topics.js";
import { RELEASE_DATE, countdownParts, FACTS } from "../lib/data/gta6.js";
import { RELEASES, upcomingByMonth, fmtDay } from "../lib/data/releases.js";
import { fetchFreeGames, fmtWhen } from "../lib/data/epic.js";

const now = new Date();
const today = now.toISOString().slice(0, 10);
const nextReleases = upcomingByMonth(RELEASES, today).flatMap((g) => g.items).slice(0, 6);
const epic = await fetchFreeGames();
const guides = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 6);
const quick = FACTS.filter((f) => ["Release date", "Platforms", "Standard Edition", "PC version"].includes(f.label));
---
<Base title={SITE.name} description={SITE.description}>
  <section class="relative overflow-hidden border-b">
    <div class="plan-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 pt-12 pb-12 md:pt-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center">
      <div>
        <p class="text-brand text-sm font-semibold tracking-wider uppercase">Checked · sourced · dated</p>
        <h1 class="mt-3 text-4xl leading-[1.05] font-extrabold md:text-6xl">The gaming facts you need, with the receipts.</h1>
        <p class="text-muted-foreground mt-5 max-w-[52ch] text-lg">
          GTA 6's confirmed details, a release calendar with real dates, and this week's free games. Every fact links to where it came from, and every page shows when it was last checked.
        </p>
        <div class="tick-rule mt-8 max-w-xs"></div>
      </div>
      <div class="bg-card rounded-xl border p-5 shadow-sm md:p-6">
        <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">GTA 6 launches Nov 19, 2026</p>
        <div class="mt-3"><Countdown client:load date={RELEASE_DATE} label="GTA 6" compact initial={countdownParts(RELEASE_DATE, now)} /></div>
        <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
          {quick.map((f) => <><dt class="text-muted-foreground">{f.label}</dt><dd class="text-right font-medium">{f.value}</dd></>)}
        </dl>
        <a href="/gta-6/" class="mt-5 inline-block text-sm font-semibold">Everything confirmed about GTA 6 →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-2" aria-label="This week">
    <div>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-extrabold">Free on Epic now</h2>
        <a href="/free-games/" class="text-sm font-medium">Free games tracker →</a>
      </div>
      {epic?.current?.length ? (
        <ul class="mt-4 grid gap-3">
          {epic.current.map((g) => (
            <li class="bg-card rounded-lg border p-4">
              <a href={g.url} rel="noopener" class="font-semibold">{g.title}</a>
              <p class="text-muted-foreground mt-1 text-sm">Free until {fmtWhen(g.end)}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground mt-4">See the <a href="/free-games/">free games tracker</a> for this week's giveaway and how to claim it.</p>
      )}
    </div>
    <div>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-extrabold">Releasing next</h2>
        <a href="/release-dates/" class="text-sm font-medium">Full calendar →</a>
      </div>
      <ul class="bg-card mt-4 divide-y rounded-lg border">
        {nextReleases.map((r) => (
          <li class="flex items-baseline justify-between gap-4 px-4 py-3">
            <span class="min-w-0">{r.href ? <a href={r.href} class="font-semibold">{r.title}</a> : <span class="font-semibold">{r.title}</span>}<span class="text-muted-foreground block text-xs">{r.platforms.join(" · ")}</span></span>
            <time datetime={r.date} class="num text-muted-foreground shrink-0 text-sm">{fmtDay(r.date)}</time>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {guides.length > 0 && (
    <section aria-labelledby="guides-h" class="border-t">
      <div class="mx-auto max-w-6xl px-4 py-14">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="guides-h" class="text-3xl font-extrabold">Latest guides</h2>
          <a href="/guides/" class="text-sm font-medium">All guides →</a>
        </div>
        <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {guides.map((g) => (
            <li>
              <a href={`/guides/${g.id}/`} class="bg-card hover:border-brand group text-foreground flex h-full flex-col gap-3 rounded-xl border p-5 no-underline transition-colors">
                <span class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{TOPIC_BY_KEY[g.data.tool].topic}</span>
                <span class="font-display group-hover:text-brand text-lg leading-snug font-bold">{g.data.title}</span>
                <span class="text-muted-foreground text-sm">{g.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section aria-labelledby="how-h" class="border-t">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-3">
      <div class="md:col-span-1">
        <h2 id="how-h" class="text-2xl font-extrabold">How we work</h2>
        <p class="text-muted-foreground mt-2">Rules we hold every page to. Details on <a href="/how-we-verify/">how we verify</a>.</p>
      </div>
      <ol class="grid gap-4 md:col-span-2 sm:grid-cols-3">
        {[
          ["Sourced", "Every fact links to the official announcement or the report it came from."],
          ["Separated", "Confirmed facts and rumors never share a table. Rumors are labeled."],
          ["Dated", "Pages show when their facts were last checked, and trackers rebuild daily."],
        ].map(([t, b], i) => (
          <li class="bg-card rounded-xl border p-5">
            <span class="num text-brand text-sm font-semibold">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-1 text-base font-bold">{t}</h3>
            <p class="text-muted-foreground mt-1 text-sm">{b}</p>
          </li>
        ))}
      </ol>
    </div>
    <p class="mx-auto max-w-6xl px-4 pb-14 text-sm text-muted-foreground">Written and built by <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a>. {SITE.name} is independent and not affiliated with any game publisher.</p>
  </section>
</Base>
