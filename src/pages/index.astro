---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { SITE, AUTHOR } from "../site.config.js";
import { TOPIC_BY_KEY } from "../lib/topics.js";

const guides = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const featuredGuide = guides[0];
const recentGuides = guides.slice(1);
---
<Base title={SITE.name} description={SITE.description}>
  {/* Temiz, Güven Verici Editoryal Giriş Bölümü */}
  <section class="relative overflow-hidden border-b bg-card/40">
    <div class="plan-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 pt-12 pb-14 md:pt-16 md:pb-16">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-muted-foreground shadow-2xs">
          <span class="h-2 w-2 rounded-full bg-brand"></span>
          <span>Independent gaming guides & release schedules</span>
        </div>

        <h1 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight md:text-5xl lg:text-6xl text-foreground">
          Practical gaming answers, backed by official announcements.
        </h1>
        
        <p class="text-muted-foreground mt-4 text-base md:text-lg leading-relaxed max-w-[58ch]">
          Clear explanations for major releases like GTA 6, upcoming console launch dates, and weekly free games — with every single fact referenced back to its original source.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
          <a href="/guides/" class="inline-flex items-center gap-2 rounded-lg bg-foreground px-4 py-2.5 font-semibold text-background transition-colors hover:bg-foreground/90 no-underline shadow-2xs">
            <span>Browse All Guides</span>
            <span>→</span>
          </a>
          <a href="/release-dates/" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 font-medium text-foreground no-underline hover:bg-accent/50 transition-colors">
            <span>Release Calendar</span>
          </a>
          <a href="/about/" class="text-xs text-muted-foreground hover:text-foreground font-medium px-2 py-2 no-underline transition-colors">
            About This Site →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Ana İçerik: Öne Çıkan Rehber ve Akış */}
  <section class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <div class="grid gap-10 lg:grid-cols-12 items-start">
      
      {/* Sol Sütun (8 Kolon): Manşet ve Son Makaleler */}
      <div class="lg:col-span-8 space-y-10">
        {featuredGuide && (
          <div>
            <div class="flex items-center justify-between border-b pb-2.5 mb-5">
              <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Featured Guide</span>
              <time datetime={featuredGuide.data.published.toISOString()} class="text-xs text-muted-foreground font-mono num">
                {featuredGuide.data.published.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
              </time>
            </div>

            <article class="glow-card group rounded-xl border border-border bg-card p-6 md:p-7 transition-all">
              <a href={`/guides/${featuredGuide.id}/`} class="no-underline block">
                <span class="inline-block rounded-md bg-brand-soft px-2.5 py-0.5 text-xs font-bold text-brand uppercase tracking-wider">
                  {TOPIC_BY_KEY[featuredGuide.data.tool].topic}
                </span>
                
                <h2 class="font-display group-hover:text-brand mt-3 text-2xl md:text-3xl font-extrabold text-foreground transition-colors leading-snug">
                  {featuredGuide.data.title}
                </h2>
                
                <p class="text-muted-foreground mt-3 text-base leading-relaxed">
                  {featuredGuide.data.description}
                </p>
                
                <div class="mt-5 flex items-center gap-1.5 text-sm text-brand font-semibold">
                  <span>Read full guide</span>
                  <span>→</span>
                </div>
              </a>
            </article>
          </div>
        )}

        {/* Son Rehberler */}
        {recentGuides.length > 0 && (
          <div class="border-t pt-8">
            <div class="flex items-baseline justify-between mb-5">
              <h2 class="text-xl font-extrabold tracking-tight">Recent Guides</h2>
              <a href="/guides/" class="text-xs font-semibold text-brand hover:underline">All guides ({guides.length}) →</a>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              {recentGuides.map((g) => {
                const dateStr = g.data.published.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
                return (
                  <article class="glow-card group rounded-xl border border-border bg-card p-5 flex flex-col justify-between">
                    <a href={`/guides/${g.id}/`} class="no-underline block">
                      <div class="flex items-center justify-between text-xs text-muted-foreground mb-2">
                        <span class="font-semibold text-foreground uppercase tracking-wider text-[11px]">{TOPIC_BY_KEY[g.data.tool].topic}</span>
                        <time datetime={g.data.published.toISOString()} class="num font-mono">{dateStr}</time>
                      </div>
                      
                      <h3 class="font-display group-hover:text-brand text-base font-bold text-foreground transition-colors leading-snug line-clamp-2">
                        {g.data.title}
                      </h3>
                      
                      <p class="text-muted-foreground mt-2 text-xs leading-relaxed line-clamp-2">
                        {g.data.description}
                      </p>
                    </a>

                    <div class="mt-4 pt-3 border-t border-border flex items-center justify-between text-xs">
                      <span class="text-muted-foreground">By Eren Şimşir</span>
                      <a href={`/guides/${g.id}/`} class="text-brand font-semibold hover:underline">Read →</a>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        )}
      </div>

      {/* Sağ Sütun (4 Kolon): Diğer Sayfalara Sade Bağlantılar ve Yazar */}
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-20" aria-label="Explore and about">
        
        {/* Hızlı Sayfa Bağlantıları */}
        <div class="rounded-xl border border-border bg-card p-5">
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted-foreground pb-2 border-b">
            Explore Topics
          </h3>
          
          <ul class="mt-3 divide-y divide-border text-sm">
            <li class="py-2.5 first:pt-0">
              <a href="/gta-6/" class="font-semibold text-foreground hover:text-brand flex items-center justify-between no-underline">
                <span>GTA 6 Hub</span>
                <span class="text-muted-foreground text-xs">→</span>
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">Confirmed launch date, prices, editions and map details.</p>
            </li>
            
            <li class="py-2.5">
              <a href="/release-dates/" class="font-semibold text-foreground hover:text-brand flex items-center justify-between no-underline">
                <span>Release Date Calendar</span>
                <span class="text-muted-foreground text-xs">→</span>
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">Upcoming console and PC games with confirmed dates.</p>
            </li>

            <li class="py-2.5 last:pb-0">
              <a href="/free-games/" class="font-semibold text-foreground hover:text-brand flex items-center justify-between no-underline">
                <span>Free Games Tracker</span>
                <span class="text-muted-foreground text-xs">→</span>
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">Updated list of this week's free titles on Epic Games Store.</p>
            </li>
          </ul>
        </div>

        {/* Yazar Bilgisi (Gerçek İnsan Vurgusu) */}
        <div class="rounded-xl border border-border bg-card p-5">
          <div class="flex gap-3.5 items-center">
            <img
              src={AUTHOR.photo}
              alt={AUTHOR.name}
              class="w-13 h-13 rounded-full object-cover border border-border shrink-0"
              width="52"
              height="52"
              loading="lazy"
            />
            <div>
              <h4 class="font-bold text-sm text-foreground">{AUTHOR.name}</h4>
              <p class="text-xs text-muted-foreground">{AUTHOR.role}</p>
              <div class="flex gap-2 text-xs font-semibold mt-1">
                <a href={AUTHOR.linkedin} rel="me noopener" target="_blank" class="text-brand hover:underline">LinkedIn ↗</a>
                <a href={AUTHOR.github} rel="me noopener" target="_blank" class="text-brand hover:underline">GitHub ↗</a>
              </div>
            </div>
          </div>
          
          <div class="mt-3.5 pt-3 border-t border-border text-xs text-muted-foreground space-y-2">
            <p>
              Software engineer tracking game releases and writing practical guides. Each article links directly to its source.
            </p>
            <div class="pt-0.5 flex gap-3 font-medium">
              <a href="/about/" class="text-foreground hover:text-brand">About the site →</a>
              <a href="/how-we-verify/" class="text-foreground hover:text-brand">How we verify →</a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {/* Doğrulama ve Güvenilirlik Notu (Samimi ve Doğal Dil) */}
  <section class="border-t bg-card/20">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="grid gap-6 md:grid-cols-3">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-foreground">Why this site exists</h2>
          <p class="text-xs text-muted-foreground mt-1">Our simple approach to gaming information.</p>
        </div>
        
        <div class="md:col-span-2 space-y-3 text-sm text-muted-foreground leading-relaxed">
          <p>
            Whenever a major game gets announced or a digital store runs a promotion, gaming forums and social media fill up with unverified leaks, guesses, and recycled rumors. Players searching for simple facts — like whether a boxed game actually includes a disc or what day a pre-load begins — usually have to sort through paragraphs of fluff.
          </p>
          <p>
            {SITE.name} is written to give you direct, verifiable answers. We verify dates and details against publisher announcements and store listings before writing about them. When a detail hasn't been confirmed yet, we simply say so.
          </p>
          
          <div class="pt-1 flex flex-wrap gap-4 text-xs font-semibold">
            <a href="/how-we-verify/" class="text-brand hover:underline">How we verify facts →</a>
            <a href="/editorial-policy/" class="text-foreground hover:text-brand">Editorial policy →</a>
            <a href="/contact/" class="text-foreground hover:text-brand">Report an error →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
