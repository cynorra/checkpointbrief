---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema, collectionSchema } from "../../lib/schema.js";
import { TOPICS } from "../../lib/topics.js";

const all = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const groups = TOPICS
  .map((t) => ({ key: t.key, label: t.topic, href: t.href, name: t.hubName, items: all.filter((g) => g.data.tool === t.key) }))
  .filter((g) => g.items.length > 0);
const crumbs = [{ name: "Home", path: "/" }, { name: "Guides", path: "/guides/" }];
---
<Base
  title="Gaming Guides"
  description="Guides to GTA 6, release dates, free games and console setup: editions, pre-loading, storage and accounts, each with sources and dates."
  schema={[breadcrumbSchema(crumbs), collectionSchema({ name: "Guides", description: "Guides to GTA 6, release dates, free games and console setup.", path: "/guides/", items: all.map((g) => ({ name: g.data.title, path: `/guides/${g.id}/` })) })]}
>
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl md:text-4xl font-extrabold">Guides</h1>
    <p class="mt-3 text-lg text-muted-foreground max-w-[60ch]">What's confirmed, what it means and what to do before launch day, with a source for every fact.</p>
    <div class="tick-rule mt-6 max-w-md"></div>

    {groups.map((group) => (
      <section class="mt-10" aria-labelledby={`g-${group.key}`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id={`g-${group.key}`} class="text-xl font-extrabold">{group.label}</h2>
          {group.name && <a href={group.href} class="text-sm font-medium">{group.name} →</a>}
        </div>
        <ul class="mt-4 grid gap-5 md:grid-cols-2">
          {group.items.map((g) => (
            <li class="border-t border-border pt-4">
              <a href={`/guides/${g.id}/`} class="font-display text-lg font-bold leading-snug">{g.data.title}</a>
              <p class="text-sm text-muted-foreground mt-1">{g.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
