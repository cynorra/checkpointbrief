---
import { pageDates } from "../page-dates.js";
import PageLayout from "../layouts/PageLayout.astro";
import { SITE } from "../site.config.js";
---
<PageLayout
  title="Terms of Use"
  description={`The terms for using ${SITE.name}, including how dates and prices should be relied on and how our content may be shared.`}
  updated={pageDates("/terms/").updated ?? pageDates("/terms/").published}
>
  <p>By using {SITE.name} ({SITE.domain}) you agree to these terms. If you don't agree, please don't use the site.</p>

  <h2>Information, not a guarantee</h2>
  <p>We work to keep dates, prices and offers accurate and show when each page was last checked, but publishers change them without notice. Confirm in the official store before you buy. See the <a href="/disclaimer/">disclaimer</a>.</p>

  <h2>Use of the site</h2>
  <p>You may read and share the site freely. You may not copy its text, tables or code in bulk, scrape it, or republish its content as your own. Quoting a short passage with a link back is fine.</p>

  <h2>Limitation of liability</h2>
  <p>To the extent the law allows, {SITE.name} is not liable for any loss arising from use of the site, including purchases made on the basis of a date, price or offer shown here.</p>

  <h2>Links</h2>
  <p>Links to stores and other websites are provided for convenience. We are not responsible for their content or offers.</p>

  <h2>Changes</h2>
  <p>These terms may change. The date at the top shows the latest version. Questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
</PageLayout>
