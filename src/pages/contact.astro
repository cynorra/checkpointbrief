---
import { pageDates } from "../page-dates.js";
import PageLayout from "../layouts/PageLayout.astro";
import { SITE } from "../site.config.js";
const endpoint = SITE.contactFormEndpoint;
---
<PageLayout
  title="Contact"
  description={`Contact ${SITE.name} to report a wrong date or fact, suggest a game to track or ask about a guide.`}
  updated={pageDates("/contact/").updated ?? pageDates("/contact/").published}
>
  <p>Email <strong><a href={`mailto:${SITE.email}`}>{SITE.email}</a></strong>. Replies usually come within two business days.</p>

  <h2>Reporting an error</h2>
  <p>If a date, price or fact on the site is wrong or out of date, send the page link and, if you can, a link to the official announcement. Confirmed corrections are made promptly and the page's updated date changes.</p>

  <h2>What we can't help with</h2>
  <p>We can't help with orders, refunds, account problems or technical support for games or stores. For those, contact the store or the publisher directly.</p>

  {endpoint && (
    <>
      <h2>Send a message</h2>
      <form action={endpoint} method="POST" class="grid max-w-lg gap-4">
        <div class="grid gap-2"><label class="text-sm font-medium" for="cf-name">Name</label><input class="border-input bg-background dark:bg-input/30 h-10 w-full rounded-md border px-3 py-2 text-base shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]" id="cf-name" name="name" autocomplete="name" required /></div>
        <div class="grid gap-2"><label class="text-sm font-medium" for="cf-email">Email</label><input class="border-input bg-background dark:bg-input/30 h-10 w-full rounded-md border px-3 py-2 text-base shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]" id="cf-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="grid gap-2"><label class="text-sm font-medium" for="cf-msg">Message</label><textarea class="border-input bg-background dark:bg-input/30 w-full rounded-md border px-3 py-2 text-base shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]" id="cf-msg" name="message" rows="6" required></textarea></div>
        <button class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 w-fit items-center rounded-md px-5 text-sm font-medium" type="submit">Send message</button>
      </form>
    </>
  )}
</PageLayout>
