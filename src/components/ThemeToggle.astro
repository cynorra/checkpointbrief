---
// Vanilla theme switcher (no React): cycles light -> dark -> system.
// The inline script in Base.astro sets the initial class before first paint.
---
<button type="button" id="theme-toggle" aria-label="Change color theme" title="Theme: system"
  class="hover:bg-accent hover:text-accent-foreground inline-flex size-9 items-center justify-center rounded-md transition-colors">
  <svg data-i="light" class="hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg data-i="dark" class="hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  <svg data-i="system" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
</button>
<script>
  type Theme = "light" | "dark" | "system";
  const btn = document.getElementById("theme-toggle") as HTMLButtonElement | null;
  const mq = window.matchMedia("(prefers-color-scheme: dark)");
  const read = (): Theme => {
    try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") return t; } catch {}
    return "system";
  };
  const apply = (t: Theme) => document.documentElement.classList.toggle("dark", t === "dark" || (t === "system" && mq.matches));
  const paint = (t: Theme) => {
    if (!btn) return;
    btn.querySelectorAll<SVGElement>("svg").forEach((s) => s.classList.toggle("hidden", s.dataset.i !== t));
    btn.title = `Theme: ${t}`;
  };
  let theme = read();
  paint(theme);
  btn?.addEventListener("click", () => {
    theme = theme === "light" ? "dark" : theme === "dark" ? "system" : "light";
    try { theme === "system" ? localStorage.removeItem("theme") : localStorage.setItem("theme", theme); } catch {}
    apply(theme);
    paint(theme);
  });
  mq.addEventListener("change", () => { if (read() === "system") apply("system"); });
</script>
