---
// A checkpoint flag on its pole: the save point that names the site.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="7" y="3" width="2.5" height="27" rx="1" fill="currentColor" />
  <path d="M9.5 4h16l-4 5.5 4 5.5h-16z" fill="var(--brand)" />
  <rect x="4" y="27.5" width="9" height="2.5" rx="1" fill="currentColor" />
</svg>
